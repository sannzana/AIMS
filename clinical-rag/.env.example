# Copy this file to .env inside clinical-rag and insert your own API key.
LLM_PROVIDER=api
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=replace_with_your_groq_api_key

# Successful LLM responses are cached locally. Use fictional patient data only.
LLM_CACHE=1
# Optional request metrics (no prompt or response text).
AIMS_TELEMETRY=0
AIMS_LLM_TIMEOUT_SECONDS=30
